# CAELUS — Ortam Değişkenleri Şablonu (.env.example)
# GÜVENLİK KURALI: Bu dosya yalnızca ortam değişkeni ADLARINI içerir.
# Gizli anahtarları (secret/API key) asla git deposuna veya bu dosyaya yazmayın.

# Google Photorealistic 3D Tiles (İsteğe Bağlı, Varsayılan: KAPALI)
# Yalnızca kullanıcı kendi Google Cloud faturalandırmalı API anahtarını girdiğinde
# ve maliyet onayını açıkça verdiğinde etkinleşir.
CAELUS_GOOGLE_3DTILES_API_KEY=
CAELUS_GOOGLE_3DTILES_BILLING_CONSENT=false

# Eclipse Ditto Dijital İkiz Servisi (İsteğe Bağlı, Varsayılan: Yerel Simülatör / Örnek Cihaz)
# Kurumsal Ditto sunucusuna bağlanmak için yalnızca yetkili uç nokta ve kimlik bilgisi tanımlayın.
CAELUS_DITTO_ENDPOINT=
CAELUS_DITTO_AUTH_TOKEN=

# NASA JPL Horizons Yerel Vekil (Proxy) Uç Noktası (İsteğe Bağlı)
# Tarayıcı CORS kısıtlaması durumunda yerel C++/Rust/Node vekili üzerinden sorgu için.
CAELUS_JPL_HORIZONS_PROXY_URL=

# Yerel LLM (Ollama) Uç Noktası (Varsayılan: Yalnızca localhost / 127.0.0.1:11434)
CAELUS_OLLAMA_ENDPOINT=http://127.0.0.1:11434
CAELUS_OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b

# CAELUS C++17 Motoru Yerel İletişim Anahtarı (İsteğe Bağlı)
CAELUS_INTEL_TOKEN=
